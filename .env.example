# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Every environment variable the app reads should be listed here with a one-line comment.

# --- LLM provider keys ---
# These are read by pydantic-ai's stock provider classes, not by code in this
# repo. The names below are the ones pydantic-ai's providers default to —
# changing them will break key discovery. Only set the keys for providers you
# actually intend to use (configs/models.yaml).
OPENAI_API_KEY=            # openai:* models (gpt-4o, …)
ANTHROPIC_API_KEY=         # anthropic:* models (claude-sonnet-4-5, …)
DEEPSEEK_API_KEY=          # deepseek:* models
GEMINI_API_KEY=            # google:* models (Gemini via AI Studio)
ALIBABA_API_KEY=           # alibaba:* models (Qwen via DashScope; DASHSCOPE_API_KEY also accepted)
MOONSHOTAI_API_KEY=        # moonshotai:* models (Kimi)
OPENROUTER_API_KEY=        # openrouter:* models

# --- OCR service ---
MINERU_API_TOKEN=          # MineRU document parsing API (PDF/doc/ppt/excel); create at mineru.net/apiManage

# --- Observability ---
PHOENIX_API_KEY=           # Phoenix tracing — only required when configs/app.yaml tracing.endpoint points at a remote Phoenix instance; leave blank for local

# --- Medical-clip server (BiomedCLIP zero-shot, attachment-ingest modality gate) ---
# Boot via `uv run --extra medical-clip-server claritymed-medical-clip-server`.
# CLARITYMED_MEDICAL_CLIP_PORT overrides the default 8086 bind. HF_HOME
# routes the BiomedCLIP weight cache (~400 MB) into a non-default
# directory — useful when ~/.cache/huggingface is on a small partition.
CLARITYMED_MEDICAL_CLIP_PORT=  # default 8086; loopback-only (host hardcoded 127.0.0.1)
HF_HOME=                       # huggingface_hub cache root; default ~/.cache/huggingface

# --- Vision server (per-disease detection — Unit 4) ---
# Boot via `uv run --extra vision-server claritymed-vision-server` once
# Unit 4 ships. Port override below; ~/.claritymed/models/vision/ must
# carry a promoted artifact for the disease entry to load.
CLARITYMED_VISION_PORT=        # default 8085; loopback-only
