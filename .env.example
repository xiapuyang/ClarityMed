# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Every environment variable the app reads should be listed here with a one-line comment.

# --- LLM provider keys ---
# Each maps to a ``providers[*].api_key_env`` in configs/models.yaml. Only set the
# keys for providers you actually intend to use; missing keys are tolerated until
# resolve_provider() picks one that needs it.
OPENAI_API_KEY=            # configs/models.yaml id=openai
DEEPSEEK_API_KEY=          # configs/models.yaml id=deepseek
GEMINI_API_KEY=            # configs/models.yaml id=gemini
DASHSCOPE_API_KEY=         # configs/models.yaml id=qwen (Aliyun DashScope)
MOONSHOT_API_KEY=          # configs/models.yaml id=kimi
OPENROUTER_API_KEY=        # configs/models.yaml id=openrouter
ANTHROPIC_API_KEY=         # configs/models.yaml id=claude
